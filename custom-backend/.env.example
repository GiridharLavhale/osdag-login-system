# Copy this file to .env and fill in real values. Never commit .env itself.

# Get this from your Neon (https://neon.tech) or Supabase project dashboard.
# Neon example: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login session lasts before it expires even if not revoked
JWT_EXPIRES_IN=30m

PORT=3000
